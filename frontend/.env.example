# Example configuration for the calculator frontend.
# Copy to .env.local and adjust. Vite only exposes variables prefixed VITE_,
# and every one of them is bundled into the JavaScript the browser downloads.

# Base URL of the backend API, without a trailing slash.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Credentials for POST /api/v1/auth/token, used only when the backend runs
# with AUTH_ENABLED=true.
#
# WARNING: a browser application cannot keep a secret. Anything set here ends
# up in the bundle and is readable by anyone who opens the network tab. These
# variables exist so the app can be run against a locally secured backend
# during development. A production deployment would obtain the token from a
# backend-for-frontend or an identity provider redirect instead, and would
# leave both of these empty.
VITE_API_CLIENT_ID=
VITE_API_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Live preview
# ---------------------------------------------------------------------------
# Where the preview under the expression is calculated while you type:
#
#   local   in the browser. Instant, costs nothing, and works offline.
#   remote  by the server, on every change. The preview then comes from the
#           same engine as the answer, at the price of a request per pause.
#
# This is only the starting value. The switch in the header changes it at any
# time and the choice is remembered per browser, so there is no rebuild
# involved in trying the other mode.
VITE_PREVIEW_MODE=local

# How long typing must pause before a remote preview is requested.
#
# This is what makes remote mode usable: without it every keystroke is a
# request, the rate limit is spent on typing, and the calculation the user
# actually waited for is refused with 429. Set it to 0 to see exactly that.
VITE_PREVIEW_DEBOUNCE_MS=300
