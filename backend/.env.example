# Example configuration for the calculator microservice.
# Copy to .env and adjust; never commit a filled-in copy.
# Every variable is optional: the defaults shown here are what the service
# applies when the variable is absent.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | production. Production switches on JSON logging and HSTS.
APP_ENV=development
APP_VERSION=1.0.0
PORT=8080

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma separated allowlist. Requests from any other origin receive no CORS
# headers, so browsers refuse to expose the response.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to true ONLY when the service sits behind a proxy you control. When true,
# the client IP for rate limiting is read from X-Forwarded-For, which a direct
# client could otherwise spoof to get a fresh bucket per request.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Rate limiting (token bucket, per client IP)
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# When true, POST /api/v1/calculate requires a Bearer token. The service then
# refuses to start unless BOTH JWT_SECRET (min 32 chars) and API_CLIENT_SECRET
# (min 16 chars) are set: without a client secret the token endpoint would hand
# a valid token to any anonymous caller, making the auth layer decorative.
# Generate secrets with:
#   openssl rand -base64 48
AUTH_ENABLED=false
JWT_SECRET=
JWT_ISSUER=abacus-calculator
JWT_TTL_SECONDS=3600

# Credentials accepted by POST /api/v1/auth/token. With AUTH_ENABLED=false the
# secret may stay empty and the endpoint issues tokens freely, which is only
# ever appropriate for local development.
API_CLIENT_ID=calculator-client
API_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
MAX_EXPRESSION_LENGTH=500
MAX_NESTING_DEPTH=20
MAX_REQUEST_BODY_BYTES=65536

# ---------------------------------------------------------------------------
# Server timeouts (seconds)
# ---------------------------------------------------------------------------
READ_TIMEOUT_SECONDS=5
WRITE_TIMEOUT_SECONDS=10
IDLE_TIMEOUT_SECONDS=60
SHUTDOWN_TIMEOUT_SECONDS=10
